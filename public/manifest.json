{
  "manifest_version": 3,
  "name": "VINYL — Music Journal",
  "version": "0.3.1",
  "description": "오늘의 앨범과 음악 감상 기록을 위한 버건디 뮤직 저널",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "VINYL Music Journal",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "permissions": ["storage", "notifications", "alarms"]
}
